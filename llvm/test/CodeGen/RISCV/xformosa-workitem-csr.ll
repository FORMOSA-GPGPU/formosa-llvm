; get_global_id(0) = group_id * local_size + local_id + global_offset.
define i64 @global_id_x() {
; CHECK-LABEL: global_id_x:
; CHECK:       # %bb.0:
; CHECK-NEXT:    csrr a0, xgroupid_x
; CHECK-NEXT:    csrr a1, xlocalsize_x
; CHECK-NEXT:    csrr a2, xlocalid_x
; CHECK-NEXT:    csrr a3, xglobaloffset_x
; CHECK-NEXT:    mul a0, a0, a1
; CHECK-NEXT:    add a2, a2, a3
; CHECK-NEXT:    add a0, a0, a2
; CHECK-NEXT:    ret
  %gid = call i64 @llvm.riscv.fsa.group.id.x()
  %size = call i64 @llvm.riscv.fsa.local.size.x()
  %lid = call i64 @llvm.riscv.fsa.local.id.x()
  %off = call i64 @llvm.riscv.fsa.global.offset.x()
  %base = mul i64 %gid, %size
  %a = add i64 %base, %lid
  %b = add i64 %a, %off
  ret i64 %b
}

; Two reads of the same CSR are merged into one csrr.
define i64 @merged_reads() {
; CHECK-LABEL: merged_reads:
; CHECK:       # %bb.0:
; CHECK-NEXT:    csrr a0, xlocalid_x
; CHECK-NEXT:    xori a1, a0, 7
; CHECK-NEXT:    add a0, a1, a0
; CHECK-NEXT:    ret
  %a = call i64 @llvm.riscv.fsa.local.id.x()
  %b = call i64 @llvm.riscv.fsa.local.id.x()
  %c = xor i64 %a, 7
  %d = add i64 %c, %b
  ret i64 %d
}

; The read is hoisted out of the loop.
define void @hoisted_read(ptr %p, i64 %n) {
; CHECK-LABEL: hoisted_read:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a2, 0
; CHECK-NEXT:    csrr a3, xlocalid_x
; CHECK-NEXT:  .LBB17_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    add a4, a3, a2
; CHECK-NEXT:    slli a4, a4, 3
; CHECK-NEXT:    add a4, a0, a4
; CHECK-NEXT:    sd a2, 0(a4)
; CHECK-NEXT:    addi a2, a2, 1
; CHECK-NEXT:    bne a1, a2, .LBB17_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %lid = call i64 @llvm.riscv.fsa.local.id.x()
  %idx = add i64 %i, %lid
  %addr = getelementptr i64, ptr %p, i64 %idx
  store i64 %i, ptr %addr
  %i.next = add i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; A value that lives across a call is re-read after the call instead of being
; kept in a callee-saved register or spilled.
declare void @use(i64)

define void @reread_across_call() {
; CHECK-LABEL: reread_across_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    csrr a0, xlocalid_x
; CHECK-NEXT:    call use
; CHECK-NEXT:    csrr a0, xlocalid_x
; CHECK-NEXT:    call use
; CHECK-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
  %lid = call i64 @llvm.riscv.fsa.local.id.x()
  call void @use(i64 %lid)
  call void @use(i64 %lid)
  ret void
}
