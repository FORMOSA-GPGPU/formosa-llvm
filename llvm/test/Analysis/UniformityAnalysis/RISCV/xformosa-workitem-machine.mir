# RUN: llc -mtriple=riscv64 -mattr=+xformosa,+f \
# RUN:   -run-pass=print-machine-uniformity -o - %s 2>&1 | FileCheck %s

# Machine uniformity of the work-item CSR reads: the pseudos selected from the
# work-item intrinsics, and the old value of any CSR instruction on a per-lane
# CSR: the per-thread CSRs (read-only 0xFD0-0xFDF, read/write 0xBD0-0xBDF),
# mhartid, and the floating-point CSRs. Other CSRs, such as xwid and cycle,
# are not divergent by themselves.

# CHECK-LABEL: MachineUniformityInfo for function: workitem
# CHECK: DIVERGENT: %0: %0:gpr = PseudoFSA_LOCAL_ID_X
# CHECK: DIVERGENT: %1: %1:gpr = PseudoFSA_LOCAL_LINEAR_ID
# CHECK: DIVERGENT: %2: %2:gpr = PseudoFSA_LANE_ID
# CHECK: {{^ +}}%3: %3:gpr = PseudoFSA_SUB_GROUP_SIZE
# CHECK: {{^ +}}%4: %4:gpr = PseudoFSA_GROUP_ID_X
# CHECK: {{^ +}}%5: %5:gpr = PseudoFSA_LOCAL_SIZE_Y
# CHECK: {{^ +}}%6: %6:gpr = PseudoFSA_GLOBAL_OFFSET_Z
# CHECK: DIVERGENT: %7: %7:gpr = CSRRS 4048, $x0
# CHECK: DIVERGENT: %8: %8:gpr = CSRRS 3024, $x0
# CHECK: DIVERGENT: %9: %9:gpr = CSRRS 3860, $x0
# CHECK: DIVERGENT: %10: %10:gpr = CSRRW 3024, %4
# CHECK: DIVERGENT: %11: %11:gpr = CSRRC 3025, %4
# CHECK: DIVERGENT: %12: %12:gpr = CSRRS 1, $x0
# CHECK: DIVERGENT: %13: %13:gpr = CSRRWI 2, 1
# CHECK: DIVERGENT: %14: %14:gpr = CSRRSI 3, 0
# CHECK: DIVERGENT: %15: %15:gpr = ReadFRM
# CHECK: DIVERGENT: %16: %16:gpr = ReadFFLAGS
# CHECK: {{^ +}}%17: %17:gpr = CSRRS 4032, $x0
# CHECK: {{^ +}}%18: %18:gpr = CSRRW 3008, %4
# CHECK: {{^ +}}%19: %19:gpr = CSRRS 3072, $x0

---
name: workitem
tracksRegLiveness: true
body: |
  bb.0:
    %0:gpr = PseudoFSA_LOCAL_ID_X
    %1:gpr = PseudoFSA_LOCAL_LINEAR_ID
    %2:gpr = PseudoFSA_LANE_ID
    %3:gpr = PseudoFSA_SUB_GROUP_SIZE
    %4:gpr = PseudoFSA_GROUP_ID_X
    %5:gpr = PseudoFSA_LOCAL_SIZE_Y
    %6:gpr = PseudoFSA_GLOBAL_OFFSET_Z
    ; xlaneid (0xFD0), xlocalid_x (0xBD0), mhartid (0xF14)
    %7:gpr = CSRRS 4048, $x0
    %8:gpr = CSRRS 3024, $x0
    %9:gpr = CSRRS 3860, $x0
    ; Old values from other CSR instructions: xlocalid_x, xlocalid_y (0xBD1)
    %10:gpr = CSRRW 3024, %4
    %11:gpr = CSRRC 3025, %4
    ; fflags (0x001), frm (0x002), fcsr (0x003)
    %12:gpr = CSRRS 1, $x0
    %13:gpr = CSRRWI 2, 1
    %14:gpr = CSRRSI 3, 0
    %15:gpr = ReadFRM implicit $frm
    %16:gpr = ReadFFLAGS implicit $fflags
    ; xwid (0xFC0), xsgsize (0xBC0), cycle (0xC00)
    %17:gpr = CSRRS 4032, $x0
    %18:gpr = CSRRW 3008, %4
    %19:gpr = CSRRS 3072, $x0
    $x10 = COPY %0
    PseudoRET implicit $x10
...
